# sprintctl normal work is served by the Vuoro work adapter. Tenant isolation
# is by repo_id ("auditctl") recorded in .sprintctl/backend.json, which requires
# served: without this file the backend defaulted to local and every sprintctl
# call failed with "SPRINTCTL_BACKEND=local cannot be used in repo auditctl".
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
unset SPRINTCTL_URL

# auditctl sidecar. AUDITCTL_ARTIFACTS_ROOT is not optional: audit writes fail
# with "AUDITCTL_ARTIFACTS_ROOT is required for audit writes" without it.
export AUDITCTL_DB="${PWD}/.auditctl/auditctl.db"
export AUDITCTL_ARTIFACTS_ROOT="/projects/dev"

# Host-specific overrides belong in .envrc.local, which is gitignored.
source_env_if_exists .envrc.local
