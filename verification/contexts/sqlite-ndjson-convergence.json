    "legacy-events-without-envelope-fields-remain-rebuildable"
  ],
  "faults": [
    "append-error-before-fsync",
    "crash-after-ndjson-fsync-before-sqlite-commit",
    "sqlite-commit-error-after-append",
    "partial-final-line"
  ],
  "oracles": ["event-id-set-comparison", "origin-tuple-uniqueness-query", "stream-sequence-contiguity", "ndjson-parse", "sqlite-invariant-query", "rebuild-idempotency"],
  "implementation_anchors": ["auditctl/cli.py:add_cmd", "auditctl/cli.py:_reconcile_shards_before_allocation", "auditctl/db.py:allocate_origin", "auditctl/db.py:observe_origin", "auditctl/ndjson.py:append_event", "auditctl/cli.py:rebuild_cmd", "tests/test_dual_write.py:test_restart_reconciles_fsynced_ndjson_before_reusing_sequence"],
  "expansions": ["semantic-doc", "stateful-test", "concurrent-history", "fault-scenario"]
