.DS_Store
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.auditctl/


# Evidence for scopes this repository does not own. The artifacts root resolves
# to the repository a write came from, so a publisher running here under another
# scope lands it here. Only _artifacts/auditctl/ is this repository's to keep --
# the same rule agentops states for itself.
/_artifacts/*
!/_artifacts/auditctl/

# Optional external verifier checkout used by consumer/release test fixtures.
/agentops-query/

# auditctl NDJSON shards written by hooks into this checkout. Since 2026-09-30
# they are no longer committed: audit-shards-collect copies them out of every
# checkout (by file glob, independent of Git) and audit-shards-publish replicates
# them to the private bayleaf/audit-archive repository, the successor evidence
# home (gitops-nixos docs/runbooks/audit-persistence.md). Shards committed before that stay
# tracked as append-only history; this rule only hides new, untracked shards.
_artifacts/*/audit*/
